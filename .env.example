# ─────────────────────────────────────────────────────────────────────────────
# Shopify Storefront API  (required only when you switch the store to live mode)
# ─────────────────────────────────────────────────────────────────────────────

# Your myshopify domain, WITHOUT protocol. e.g. jl-industries-hub.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Public Storefront API access token (Shopify admin → Settings → Apps and sales
# channels → Develop apps → your app → API credentials → Storefront API token).
# This token is designed to be public and is safe in client bundles.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version. Update roughly quarterly.
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01

# ─────────────────────────────────────────────────────────────────────────────
# Server-only secrets — NEVER prefix these with NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────────────────────

# Admin API access token. Only needed if you later add server-side jobs such as
# catalogue sync or order lookups. Not used by the storefront today.
SHOPIFY_ADMIN_API_TOKEN=

# Shared secret used to verify incoming Shopify webhooks (product/inventory
# updates triggering on-demand revalidation).
SHOPIFY_WEBHOOK_SECRET=

# Secret appended to /api/revalidate?secret=… so only you can purge the cache.
REVALIDATION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com
